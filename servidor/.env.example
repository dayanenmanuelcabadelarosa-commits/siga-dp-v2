# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" nunca se sube al repositorio (ver .gitignore).

# ---- Base de datos PostgreSQL -------------------------------------------
# Estos valores se usan a partir de la Fase 1 (base de datos) y la Fase 2
# (núcleo del servidor). Aquí quedan documentados desde el primer día.
BD_HOST=localhost
BD_PUERTO=5432
BD_USUARIO=postgres
BD_CLAVE=pon-aqui-tu-clave
BD_NOMBRE=siga_dp_v2

# ---- Servidor ------------------------------------------------------------
PUERTO=4000
# Orígenes permitidos para CORS, separados por coma.
ORIGENES=http://localhost:5173

# ---- Sesiones ------------------------------------------------------------
# Secreto para firmar las sesiones. Escribe algo largo y aleatorio.
# Se genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLAVE_SESION=cambia-esto-por-una-cadena-larga-y-aleatoria
# Cuántas horas dura una sesión antes de tener que volver a entrar.
SESION_HORAS=12

# ---- Límite de peticiones (rate limiting) --------------------------------
# Peticiones por dirección IP cada 15 minutos, para toda la API.
LIMITE_PETICIONES=300
# Intentos de ingreso por dirección IP cada 15 minutos. Es aparte del bloqueo
# de la cuenta a los 3 intentos fallidos que pide la RN-24.
LIMITE_INGRESOS=10

# ---- Integraciones (Fase 8) ----------------------------------------------
# Las claves NUNCA van en la base de datos (RN-25): viven en el ".env" y solo
# en el ".env". Este archivo es el ejemplo: aquí van VACÍAS, nunca las claves
# de verdad. Si una clave real llega a Git, hay que rotarla.

# PayPal. Entorno: "sandbox" para pruebas o "produccion" para el real.
# Las claves se sacan de https://developer.paypal.com/dashboard/ (sandbox).
PAYPAL_ENTORNO=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MONEDA=USD
# El id del webhook, para verificar la firma de lo que PayPal avisa.
# Sale del panel de PayPal, en "Webhooks".
PAYPAL_WEBHOOK_ID=

# Facturación electrónica (plataforma IMECF). La clave es la de la empresa.
IMECF_API_URL=https://ecf-platform-backend-50801509587.us-central1.run.app
IMECF_API_KEY=

# Asistente de IA (Groq). La clave se crea en https://console.groq.com/keys.
# El modelo se puede cambiar; el predeterminado es openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
