# ============================================================
# SIGA-DP v2 — variables de entorno del servidor
# Copia este archivo a servidor/.env y pon tus valores reales.
# Nunca subas servidor/.env (está en .gitignore).
# ============================================================

# --- Base de datos (Cloud SQL en producción) ---
# En Cloud Run se usa el socket Unix de Cloud SQL. El puerto se omite cuando
# BD_HOST empieza por "/" (pg usa 5432 por defecto).
BD_HOST=/cloudsql/PROJECT_ID:us-central1:siga-dp-db
BD_PUERTO=5432
BD_USUARIO=postgres
BD_NOMBRE=siga_dp_v2
BD_CLAVE=tu-clave-de-postgres-aqui

# --- PostgreSQL externo (Neon / Supabase / Render) ---
# Para un host TCP, BD_HOST es el nombre del servidor y BD_PUERTO el puerto.
# BD_SSL=true fuerza TLS. La verificación del certificado está activa por
# defecto; BD_SSL_VERIFICAR=false solo si el proveedor usa un certificado que
# Node no reconoce (debilita la conexión).
# BD_SSL=false
# BD_SSL_VERIFICAR=true

# --- Conexiones ---
# Cloud Run + Cloud SQL pequeño: 5 conexiones por instancia es prudente.
# En local se puede dejar 10.
BD_MAX_CONEXIONES=10
BD_TIEMPO_CONEXION_MS=10000
BD_TIEMPO_INACTIVIDAD_MS=30000
BD_TIEMPO_SENTENCIA_MS=30000
BD_APP_NAME=siga-dp-v2

# --- Sesión (genera una propia) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLAVE_SESION=tu-clave-de-sesion-larga-y-aleatoria-de-al-menos-32-caracteres
SESION_HORAS=12

# --- Límites de peticiones ---
LIMITE_PETICIONES=300
LIMITE_INGRESOS=10

# --- Orígenes permitidos (CORS) ---
# Pon la URL pública de tu servicio de Cloud Run:
ORIGENES=https://tu-servicio-XXXX-uc.a.run.app

# --- PayPal (entorno sandbox para pruebas) ---
PAYPAL_ENTORNO=sandbox
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret
PAYPAL_MONEDA=USD
PAYPAL_WEBHOOK_ID=tu-paypal-webhook-id

# --- IMECF — Facturación electrónica ---
IMECF_API_URL=https://ecf-platform-backend-50801509587.us-central1.run.app
IMECF_API_KEY=tu-imecf-api-key
IMECF_ENDPOINT=/api/v1/ecf/send

# --- Groq — Asistente de IA ---
GROQ_API_KEY=tu-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Arranque ---
PUERTO=8080
NODE_ENV=production
# Solo para una emergencia operativa. En el despliegue normal, déjalo sin
# definir para que el contenedor aplique las migraciones pendientes.
# OMITIR_MIGRACIONES=false

# --- Semilla inicial (solo para el primer administrador) ---
# En producción se pasa por Secret Manager como SEMILLA_CLAVE. No la escribas
# aquí si este archivo puede llegar a un repositorio.
# SEMILLA_CLAVE=tu-clave-de-administrador-inicial
