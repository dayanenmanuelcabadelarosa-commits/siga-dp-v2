# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" nunca se sube al repositorio.
#
# Vite solo expone al navegador las variables que empiezan por VITE_.
# Nunca pongas aquí secretos: todo lo que empiece por VITE_ acaba en el
# código que descarga el navegador.

# Dirección de la API. En desarrollo, el servidor vive en el puerto 4000.
VITE_API_URL=http://localhost:4000
